<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/margin_8"
    android:background="@drawable/bg_border_rounded">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/imageViewItem"
        android:layout_width="@dimen/default_image_size_96dp"
        android:layout_height="@dimen/default_image_size_96dp"
        android:layout_marginHorizontal="@dimen/margin_48"
        android:layout_marginTop="@dimen/margin_16"
        android:src="@drawable/ic_app_logo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/textViewItemName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/margin_8"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="ic_app_logo asfsdgdasfghjkl;lkhj"
        android:textColor="@color/color_black"
        android:textSize="@dimen/font_18"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageViewItem" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/textViewItemDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/margin_8"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="1kg , priceg"
        android:textColor="@color/color_light_gray"
        android:textSize="@dimen/font_16"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textViewItemName" />

    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/textViewItemPrice"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/margin_8"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="$4.99"
        android:textColor="@color/color_black"
        android:textSize="@dimen/font_20"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/imageButtonAdd"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textViewItemDescription" />

    <androidx.appcompat.widget.AppCompatImageButton
        android:id="@+id/imageButtonAdd"
        android:layout_width="@dimen/default_button"
        android:layout_height="@dimen/default_button"
        android:layout_margin="@dimen/margin_8"
        android:src="@drawable/ic_add"
        app:layout_constraintBottom_toBottomOf="@+id/textViewItemPrice"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/textViewItemPrice"
        app:layout_constraintTop_toTopOf="@+id/textViewItemPrice" />

</androidx.constraintlayout.widget.ConstraintLayout>